# Build: bundle the gateway together with the shared domain logic from src/.
FROM node:24-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY tsconfig.json ./
COPY server ./server
COPY src ./src
RUN npm run build:gateway

FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8787 DATA_DIR=/data
COPY --from=build /app/dist-gateway/sheets-gateway.mjs ./sheets-gateway.mjs
RUN mkdir -p /data
VOLUME /data
EXPOSE 8787
CMD ["node", "sheets-gateway.mjs"]
